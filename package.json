{
  "name": "quake-italia",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "github:Pitusd-V2/quake-italia",
  "version": "0.1.0",
  "description": "Capire i terremoti in Italia, con i dati ufficiali INGV.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vitest run && vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "icons": "pwa-assets-generator",
    "audit:deps": "npm audit --audit-level=moderate",
    "check:fonti": "node scripts/check-sources.mjs",
    "check:zone": "node scripts/check-zone-update.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.70.0",
    "maplibre-gl": "6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "remark-frontmatter": "5.0.0",
    "remark-mdx-frontmatter": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
